# Optional local model settings.
# Copy this file to .env only for local runs. Do not commit .env.

# Target model service port used when agentdojo_cfg.model is "local".
LOCAL_LLM_PORT=8000

# AttriGuard helper model endpoint. Must be OpenAI-compatible.
ATTRIGUARD_BASE_URL=http://localhost:8000/v1
ATTRIGUARD_API_KEY=EMPTY
ATTRIGUARD_MODEL_ID=llama_3.3_70b_instruct_local

# AttriGuard runtime options.
ATTRIGUARD_LEVEL=2
ATTRIGUARD_SURVIVAL=fuzzy
ATTRIGUARD_SKIP_EMPTY_AUDIT=1
ATTRIGUARD_DEBUG=1

# Optional scorer defaults. The YAML config normally overrides these.
CRITIC_API_URL=http://localhost:8001/v1/chat/completions
CRITIC_MODEL_NAME=qwen3_32b_local
CRITIC_API_KEY=EMPTY
CRITIC_REASONING_EFFORT=medium
